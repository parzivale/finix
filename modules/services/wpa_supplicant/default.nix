{
  config,
  pkgs,
  lib,
  ...
}:
let
  cfg = config.services.wpa_supplicant;

  render = v: if lib.isBool v then (if v then "1" else "0") else toString v;

  configFile = pkgs.writeText "wpa_supplicant.conf" (
    lib.concatStrings (lib.mapAttrsToList (k: v: "${k}=${render v}\n") cfg.settings) + cfg.extraConfig
  );

  # the bus policy without the activation file beside it. The policy is what lets root own
  # `fi.w1.wpa_supplicant1` and anyone talk to it; the activation file is
  # `Exec=wpa_supplicant -u`, which dbus-daemon would run itself - as root, unsupervised - for
  # the first caller to find the name unowned. That caller is usually NetworkManager, at boot,
  # racing the unit below for the name: the copy dbus-daemon started wins, and the supervised
  # one exits with "name already in use" and is restarted against it for ever.
  busPolicy = pkgs.runCommand "wpa_supplicant-dbus-policy" { } ''
    mkdir -p $out/share/dbus-1
    cp -r ${cfg.package}/share/dbus-1/system.d $out/share/dbus-1/
  '';
in
{
  imports = [ ./providers.services.nix ];

  options.services.wpa_supplicant = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Whether to enable [wpa_supplicant](${pkgs.wpa_supplicant.meta.homepage}) as a system
        service.
      '';
    };

    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.wpa_supplicant;
      defaultText = lib.literalExpression "pkgs.wpa_supplicant";
      description = ''
        The package to use for `wpa_supplicant`.
      '';
    };

    debug = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Whether to enable debug logging.
      '';
    };

    dbus = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Whether to offer the D-Bus control interface (`-u`), which is how NetworkManager and
        similar managers add interfaces and networks. Interfaces added that way are configured
        by whoever adds them, not by {option}`settings`.
      '';
    };

    interfaces = lib.mkOption {
      type = with lib.types; listOf str;
      default = [ ];
      example = [ "wlan0" ];
      description = ''
        Interfaces wpa_supplicant manages by itself, each with the configuration generated from
        {option}`settings` and {option}`extraConfig`. Leave empty when a network manager adds
        interfaces over D-Bus.
      '';
    };

    settings = lib.mkOption {
      type =
        with lib.types;
        attrsOf (oneOf [
          bool
          int
          str
        ]);
      default = { };
      example = {
        country = "ES";
        ctrl_interface = "/run/wpa_supplicant";
        update_config = false;
      };
      description = ''
        Global `wpa_supplicant.conf` parameters, written as `key=value`. Booleans become `1` and
        `0`. See {manpage}`wpa_supplicant.conf(5)`. Only read for {option}`interfaces`.
      '';
    };

    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      example = ''
        network={
          ssid="home"
          psk="..."
        }
      '';
      description = ''
        Appended to the generated `wpa_supplicant.conf` after {option}`settings`: `network`
        blocks, mostly. It ends up in the store, so a psk written here is readable by anyone on
        the machine.
      '';
    };

    # exposed so that providers.services.nix can name it: a unit which reads this file has
    # to name it to be rebuilt when it changes.
    configFile = lib.mkOption {
      type = lib.types.raw;
      internal = true;
      readOnly = true;
      default = configFile;
      description = "Generated by this module, named by its units.";
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.dbus || cfg.interfaces != [ ];
        message = ''
          services.wpa_supplicant has neither the D-Bus interface nor any interfaces, so it
          would start with nothing to do. Set `services.wpa_supplicant.interfaces`, or leave
          `services.wpa_supplicant.dbus` on for a network manager to add them.
        '';
      }
    ];

    environment.systemPackages = [ cfg.package ];

    services.dbus.packages = lib.mkIf cfg.dbus [ busPolicy ];
  };
}
